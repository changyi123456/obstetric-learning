    "units": "metres",
    "up": "+Y",
    "head": "-Z",
    "feet": "+Z",
    "maternal_left": "+X",
    "maternal_right": "-X",
    "examiner_hand_labels": "L/R always refer to the examiner’s actual physical hand, never the maternal side. s1/s2 examiner faces head, s4 examiner faces feet."
  },
